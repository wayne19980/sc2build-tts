{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "sc2build-tts",
  "version": "0.7.2",
  "identifier": "com.sc2buildlab.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "SC2 Build Lab",
        "label": "main",
        "width": 1440,
        "height": 900,
        "maximized": true,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "alwaysOnTop": false,
        "transparent": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "sidecar/"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZCNDc2RkYyQjY5NTQyQzQKUldURVFwVzI4bTlIKy9OK2haazlnN2tuL2hyNWNNWlEwL2Q1RmhPeXQ5VC9kaVNjSElEVG5meUYK",
      "endpoints": [
        "https://gh-proxy.com/https://github.com/wayne19980/sc2build-tts/releases/latest/download/latest.json",
        "https://ghproxy.net/https://github.com/wayne19980/sc2build-tts/releases/latest/download/latest.json",
        "https://github.com/wayne19980/sc2build-tts/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
